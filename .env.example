# ══════════════════════════════════════════════════════════════
#  TELEGRAM → WHATSAPP FORWARDER — ENVIRONMENT VARIABLES
#  Copy this file to .env and fill in every value.
#  NEVER commit .env to Git.
# ══════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────
# TELEGRAM CLIENT API  (https://my.telegram.org)
# ─────────────────────────────────────────────

TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+2348012345678


# ─────────────────────────────────────────────
# WHATSAPP BUSINESS API  (https://developers.facebook.com)
# Use a PERMANENT System User token — temporary tokens expire in 24 hrs.
# ─────────────────────────────────────────────

WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_access_token_here


# ─────────────────────────────────────────────
# DASHBOARD
# ─────────────────────────────────────────────

# Password shown on the login page before accessing the dashboard.
# Leave blank to disable auth (not recommended on shared machines).
DASHBOARD_PASSWORD=your_dashboard_password_here

# Port the dashboard listens on (default 8000).
# Change if something else is already using 8000.
DASHBOARD_PORT=8000
